#!/bin/bash
# Production: multiple worker processes for higher throughput.
#   WEB_CONCURRENCY=4 ./serve   # override worker count (default 2)
# Development: DEV=1 ./serve     # single process + hot reload (workers ignored)

# Caddy owns the client-facing :3050 and serves static assets / HLS segments /
# downloaded MP4s from disk (see ~/c/server/Caddyfile); the app sits behind it.
PORT="${PORT:-3051}"
PYTHON_BIN="${PYTHON_BIN:-python_env/bin/python}"
CADDY_ACCESS_LOG="${CADDY_ACCESS_LOG:-log/caddy_access.log}"
LOG_PYTHON_BIN="${LOG_PYTHON_BIN:-$PYTHON_BIN}"

# Every labeled stream is mirrored here (uncolored) for later debugging while
# still printing to the terminal. Override with LOG_FILE=... ; log/ is gitignored.
LOG_FILE="${LOG_FILE:-log/backend.log}"
mkdir -p "$(dirname "$LOG_FILE")"
# Truncate on every start so each run's log begins from scratch.
: > "$LOG_FILE"

# The iOS app's DEVLOG records land here, posted to /api/devlog by instrumented
# builds (see devlog.py). Truncated alongside backend.log so both cover the same
# window — correlating the two is the point of having them. Exported so devlog.py
# resolves the same path this script just cleared.
export IOS_LOG_FILE="${IOS_LOG_FILE:-log/ios.jsonl}"
mkdir -p "$(dirname "$IOS_LOG_FILE")"
: > "$IOS_LOG_FILE"
# devlog.py rotates to "<name>.1" at its size cap; drop that generation too, or
# a fresh run still sits next to the previous run's overflow.
rm -f "$IOS_LOG_FILE.1"

# Truncation happens here, not in main.py's lifespan: lifespan runs once per
# gunicorn worker (6 by default) and again on every dev --reload, so it would
# wipe the log repeatedly, including mid-session.

# macOS launchd hands processes a 256-fd soft limit. Video streaming, HLS
# segment bursts, preview fetches and SQLite each hold fds, so raise the soft
# limit toward the hard cap. Defense in depth on top of closing connections.
ulimit -n "${FD_LIMIT:-8192}" 2>/dev/null || true

# Prefix every line with a colored label so interleaved streams are tellable
# apart. $1: ANSI color code, $2: label. awk (not sed) for line buffering.
# Each line is also appended, uncolored, to $LOG_FILE so the same interleaved
# view survives to disk. O_APPEND + per-line fflush keeps concurrent colorize
# processes from clobbering each other.
# gunicorn logs "Handling signal: winch" on every terminal resize (SIGWINCH);
# it is pure noise, so it is dropped from both the terminal and the log file.
NOISE_RE="${NOISE_RE:-Handling signal: winch}"
colorize() {
  awk -v p="$(printf '\033[1;%sm%-7s|\033[0m' "$1" "$2")" \
      -v plain="$(printf '%-7s|' "$2")" \
      -v logf="$LOG_FILE" \
      -v noise="$NOISE_RE" \
      '$0 ~ noise { next }
       { print p, $0; fflush(); print plain, $0 >> logf; fflush(logf) }'
}

# fd 3 preserves the real stdout so Caddy lines bypass the dev/web labels.
exec 3>&1
"$LOG_PYTHON_BIN" -u caddy_access.py \
  "$CADDY_ACCESS_LOG" \
  --watch-pid "$$" \
  | colorize 35 caddy >&3 &

# converter.py is the only process that spawns ffmpeg; web workers only enqueue.
# It starts before the web server so the jobs table exists and the queue is
# draining by the time requests arrive. The until-loop respawns it on crash:
# unlike gunicorn's workers, a bare background child that died would stall the
# whole queue silently. $$ survives the exec below, so --watch-pid works in both
# the DEV and production paths, exactly as the caddy_access.py line above does.
( until "$PYTHON_BIN" -u converter.py --watch-pid "$$"; do sleep 1; done ) 2>&1 \
  | colorize 31 convert >&3 &

if [ "$DEV" = "1" ]; then
  exec > >(colorize 36 web) 2>&1
  exec "$PYTHON_BIN" -m uvicorn main:app \
    --host 0.0.0.0 \
    --port "$PORT" \
    --reload \
    --reload-dir . \
    --reload-include '*.py' \
    --reload-exclude '.git/*' \
    --reload-exclude '.venv/*' \
    --reload-exclude 'python_env/*' \
    --reload-exclude 'videos/*' \
    --reload-exclude 'assets/splash/*' \
    --proxy-headers \
    --forwarded-allow-ips='*'
fi

# gunicorn manages the worker lifecycle (respawn on crash, graceful reload via
# SIGHUP, staged shutdown); uviorn workers do the actual ASGI serving.
# Access and error logs get their own colors via process substitution but share
# the "web" label; anything workers print directly (stdout/stderr) also gets it.
exec > >(colorize 34 web) 2>&1
exec "$PYTHON_BIN" -m gunicorn main:app \
  --worker-class uvicorn_worker.UvicornWorker \
  --workers "${WEB_CONCURRENCY:-6}" \
  --bind "0.0.0.0:$PORT" \
  --forwarded-allow-ips='*' \
  --access-logfile >(colorize 32 web >&3) \
  --error-logfile >(colorize 33 web >&3)
