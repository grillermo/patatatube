UPLOAD_TOKEN=your-secret-token-here

# Browser yt-dlp pulls YouTube cookies from (default: chrome). For a
# Chromium-based browser yt-dlp doesn't recognize by name (e.g. ego lite),
# point the nearest supported browser type at its actual profile dir instead:
# YTDLP_BROWSER=chrome:/path/to/that/browser's/profile/dir

# Plex library integration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Audio languages kept in library conversions (ISO 639-2 codes, comma-separated)
LIBRARY_AUDIO_LANGS=eng,spa

# LLM that rewrites multi-version movie filenames into short human labels
VERSION_NAME_LLM_API_KEY=
# Optional model override (default: gpt-5-nano)
VERSION_NAME_LLM_MODEL=

# Root for downloaded MP4s and HLS packages. Unset = repo-relative
# (videos/, data/hls). Set to an external volume to keep them off the boot disk.
MEDIA_ROOT=/Volumes/Media/patatatube
# Optional per-directory overrides (default to $MEDIA_ROOT/videos, $MEDIA_ROOT/data/hls)
#VIDEOS_DIR=
#HLS_DIR=

# SubQ API key (console.subq.ai). When set, a YouTube upload that names no group is filed
# into one by the `subq-snap-preview` classifier once it finishes downloading; unset, it
# stays in the inbox.
SUBQ_API_KEY=
# TypeSafe API key: the `jev` classifier, tried when SubQ fails (or alone, if
# SUBQ_API_KEY is unset).
JEV_API_KEY=
# Minimum classifier confidence to move a video out of the inbox (default 0.6)
#CLASSIFY_MIN_CONFIDENCE=0.6

# iOS release (./deploy). Public base URL of file_server, which serves
# ../file_server/files from this machine; ./deploy copies releases into it.
PATATATUBE_UPLOAD_BASE=https://files.chiq.me
# Optional: where that directory is, if not ../file_server/files
#PATATATUBE_PUBLISH_DIR=

# Send to Yoto: yosubee on the same machine, via its Caddy port (not 3201/3202).
YOSUBEE_LOCAL_URL=http://localhost:3200/upload-from-video?user=hola@grillermo.com&playlist_name=English
# Must equal LOCAL_UPLOAD_TOKEN in ~/c/yosubee's env file
YOSUBEE_LOCAL_TOKEN=
